{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "stlinkgdbtarget",
      "request": "launch",
      "name": "Motor board (ST-Link)",
      "cwd": "${workspaceFolder}",
      "preBuild": "${command:st-stm32-ide-debug-launch.build}",
      "runEntry": "main",
      "imagesAndSymbols": [
        {
          "imageFileName": "${workspaceFolder}/build/Debug/motorboard-common.elf"
        }
      ],
      "liveWatch": { "enabled": true, "samplesPerSecond": 4 }
    }
  ]
}
